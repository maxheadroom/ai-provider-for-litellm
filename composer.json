{
	"name": "wordpress/ai-provider-for-litellm",
	"description": "AI Provider for LiteLLM-backed, OpenAI-compatible endpoints (e.g. Ollama).",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"wordpress/php-ai-client": "^1.4",
		"phpunit/phpunit": "^9.6",
		"brain/monkey": "^2.6",
		"php-stubs/wordpress-stubs": "^6.7",
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"phpstan/phpstan": "^1.11"
	},
	"suggest": {
		"wordpress/php-ai-client": "Required. The core PHP AI Client SDK that this provider extends."
	},
	"autoload": {
		"psr-4": {
			"WordPress\\LiteLLMAiProvider\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"WordPress\\LiteLLMAiProvider\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"minimum-stability": "stable"
}
